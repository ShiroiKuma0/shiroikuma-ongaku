<?xml version="1.0" encoding="utf-8"?>
<!-- Folding section heading of the UI page: a thin full-width hairline above the group (hidden on
     the first section; it stays whether the section is folded or open), then a row that is the
     touch target: the bold accent heading with its icon at the left and an underline exactly as
     wide as the text, and at the right end a › when folded and a ⌄ when open.
     The underline trick: the underline View is match_parent inside a wrap_content column that
     wraps only the title, so it resolves to the text width. Every colour is set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/section_spacer"
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:id="@+id/section_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="0dp"
            android:paddingBottom="2dp">

            <app.simple.felicity.decorations.typeface.TypeFaceTextView
                android:id="@+id/section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="20sp"
                app:appFontStyle="bold"
                app:textColorStyle="accent" />

            <View
                android:id="@+id/section_underline"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/section_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textSize="22sp"
            app:appFontStyle="regular"
            app:textColorStyle="accent" />

    </LinearLayout>

</LinearLayout>
