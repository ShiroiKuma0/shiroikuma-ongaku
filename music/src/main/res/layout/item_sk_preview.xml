<?xml version="1.0" encoding="utf-8"?>
<!-- In-section live preview card (the old page-top preview, split per section): the Colors
     section shows everything, Typography hides the divider/icon row, Shape & spacing keeps a
     single line — visibilities are set in code. The card surface itself previews corner
     radius and border via LayoutBackground. -->
<app.simple.felicity.decorations.corners.DynamicCornerLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/preview_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sk_preview_header"
        android:textSize="22sp"
        app:appFontStyle="bold"
        app:textColorStyle="heading" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/preview_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/sk_preview_primary"
        android:textSize="15sp"
        app:appFontStyle="regular"
        app:textColorStyle="primary" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/preview_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sk_preview_secondary"
        android:textSize="13sp"
        app:appFontStyle="regular"
        app:textColorStyle="secondary" />

    <app.simple.felicity.decorations.typeface.TypeFaceTextView
        android:id="@+id/preview_tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sk_preview_tertiary"
        android:textSize="12sp"
        app:appFontStyle="regular"
        app:textColorStyle="tertiary" />

    <app.simple.felicity.decorations.theme.ThemeDivider
        android:id="@+id/preview_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp" />

    <LinearLayout
        android:id="@+id/preview_icon_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <app.simple.felicity.decorations.theme.ThemeIcon
            android:id="@+id/preview_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_settings"
            app:tintType="regular" />

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/preview_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/sk_preview_accent"
            android:textSize="15sp"
            app:appFontStyle="bold"
            app:textColorStyle="accent" />

    </LinearLayout>

</app.simple.felicity.decorations.corners.DynamicCornerLinearLayout>
