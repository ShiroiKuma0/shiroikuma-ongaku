<?xml version="1.0" encoding="utf-8"?>
<!-- A switch that carries an explanation: bold accent label, dim-gold description under it, and a
     thin dim-gold rule down the whole item's left edge. Minimal padding — the row is only as tall
     as its content, and the switch itself has no minimum height. Colors are set in code. -->
<app.simple.felicity.decorations.ripple.DynamicRippleLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="0dp"
    android:orientation="horizontal"
    android:paddingVertical="2dp">

    <View
        android:id="@+id/switch_rule"
        android:layout_width="2dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/switch_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            app:appFontStyle="bold"
            app:textColorStyle="accent" />

        <app.simple.felicity.decorations.typeface.TypeFaceTextView
            android:id="@+id/switch_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            app:appFontStyle="regular"
            app:textColorStyle="secondary" />

    </LinearLayout>

    <app.simple.felicity.shiroikuma.SkSwitch
        android:id="@+id/switch_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:minHeight="0dp"
        android:minWidth="0dp" />

</app.simple.felicity.decorations.ripple.DynamicRippleLinearLayout>
