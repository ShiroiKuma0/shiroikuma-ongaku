    <!-- Directory-grant repair: the music-directory list survives a restore, the permission to read it does not. -->
    <string name="sk_grant_lost_heading">Access lost — needs granting again (the picker opens there):</string>
    <string name="sk_grant_title">Music directory access needs granting again</string>
    <string name="sk_grant_body">This copy of 白い熊 音楽 no longer has permission to read a music directory it used to. Permission belongs to an installation, not to your data, so a restored or reinstalled copy always starts out this way — the directory list, favorites and playlists are intact and nothing can be scanned. Pick the same directory again and the library, favorites and playlists come back exactly as before.</string>
    <string name="sk_grant_choose">Choose the directory</string>
    <string name="sk_grant_forget">Forget it</string>
    <string name="sk_grant_not_now">Not now</string>
    <string name="sk_grant_regranted">Directory access restored — scanning the library</string>

