<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Fork (保存復元 §2a): the data door's export/import runs in a foreground service typed
         specialUse, which needs its own permission from API 34 up. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Fork (音楽端灯): system-wide edge-meteors overlay window while music plays -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Fork (保存復元): All-Files-Access so a 自由作業盤 batch run can point every sister
         app's headless export at one shared directory via the `path` extra. Without the
         grant StateExportReceiver simply falls back to the configured export directory. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Fork (保存復元 §4): without this, setPackage() on our reply/progress broadcasts fails
         SILENTLY on Android 11+ — the export runs, writes correctly and is never heard of.
         自由作業盤 is reachable already (it starts our components, which makes it visible to
         us); 応用管理 only ever calls the provider, so it has to be named here. -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>

    <application
        android:name=".application.FelicityApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:theme="@style/Theme.Felicity"
        tools:targetApi="tiramisu">

        <!-- Fork (Android Auto): declare the app as an Android Auto media app so the car
             launcher lists it and binds FelicityPlayerService's MediaLibraryService. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name=".activities.CrashReporterActivity"
            android:exported="false" />

        <!-- Fork (automation): exported headless entry point for the 自由作業盤 buttons and
             named play-playlist tasks (hand-off.md B.2). Token-gated at runtime via
             AutomationPreferences; see AutomationActivity. -->
        <activity
            android:name=".automation.AutomationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="shiroikuma.ongaku.AUTOMATION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".repository.services.AudioDatabaseService"
            android:exported="false" />

        <service
            android:name=".server.ServerModeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Fork (保存復元 §2a): the data door. 応用管理 backs this app up WITH its data and
             puts it back on a wiped phone, moving the bytes through a descriptor it opened
             itself. No android:permission — a custom one would have to be `normal` (any app may
             hold it) or `signature` (impossible: every app in this family has its own keystore),
             and neither buys anything AutomationCallers does not already check: exact package
             name, uid cross-check, pinned signing certificate. `import` lives ONLY here, never
             on the exported receiver below. -->
        <provider
            android:name=".automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true" />

        <!-- Where an export or import actually runs: a binder call returns in milliseconds and
             this can take minutes, and a backgrounded app writing for minutes is frozen
             mid-stream on this phone. -->
        <service
            android:name=".automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation data export/import" />
        </service>

        <!-- Capability discovery, readable without waking us: 応用管理 builds its list across
             every installed package with MATCH_UNINSTALLED_PACKAGES | MATCH_DISABLED_COMPONENTS,
             because a frozen app (白い熊 freezes aggressively) cannot be asked anything. An app
             without these entries is simply not offered for data backup or restore. -->
        <meta-data
            android:name="shiroikuma.automation.contract"
            android:value="2" />
        <meta-data
            android:name="shiroikuma.automation.format"
            android:value="1" />
        <meta-data
            android:name="shiroikuma.automation.min_format"
            android:value="1" />

        <!-- Fork (保存復元): the state-export automation contract — 自由作業盤 fires these to
             back up every sister app in one run. No android:permission (the caller cannot
             hold one): in v2 this receiver is the unauthenticated half of the surface, and
             deliberately so — it only ever writes where it was told to and reports what it
             did. See StateExportReceiver. -->
        <receiver
            android:name=".automation.StateExportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="shiroikuma.ongaku.action.EXPORT_STATE" />
                <action android:name="shiroikuma.ongaku.action.LIST_CATEGORIES" />
                <action android:name="shiroikuma.ongaku.action.CANCEL_EXPORT" />

            </intent-filter>
        </receiver>

        <!-- Home screen widget — the AppWidgetProvider that draws the 2×4 player tile. -->
        <receiver
            android:name=".widget.FelicityWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_blur_info" />
        </receiver>

        <!-- Handles the actual button taps (play/pause, next, prev) from the widget. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.simple.felicity.ACTION_WIDGET_PLAY_PAUSE" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_NEXT" />
                <action android:name="app.simple.felicity.ACTION_WIDGET_PREV" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>
